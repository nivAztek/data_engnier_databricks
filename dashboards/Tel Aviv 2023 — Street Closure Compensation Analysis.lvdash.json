{
  "datasets": [
    {
      "name": "monthly_trend",
      "displayName": "Monthly Compensation Trend",
      "queryLines": [
        "SELECT\n",
        "  month,\n",
        "  total_compensation_ils,\n",
        "  num_businesses_affected,\n",
        "  num_closure_days\n",
        "FROM\n",
        "  main.tel_aviv_dev.gold_monthly_compensation_trend\n",
        "ORDER BY\n",
        "  month"
      ]
    },
    {
      "name": "top_streets",
      "displayName": "Top 15 Streets by Compensation",
      "queryLines": [
        "SELECT\n",
        "  shem_rechov,\n",
        "  total_street_compensation_ils,\n",
        "  num_businesses_affected\n",
        "FROM\n",
        "  main.tel_aviv_dev.gold_compensation_per_street\n",
        "ORDER BY\n",
        "  total_street_compensation_ils DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "biz_type",
      "displayName": "Compensation by Business Type",
      "queryLines": [
        "SELECT\n",
        "  shimush,\n",
        "  total_compensation_ils,\n",
        "  num_businesses,\n",
        "  avg_compensation_ils\n",
        "FROM\n",
        "  main.tel_aviv_dev.gold_compensation_by_business_type\n",
        "ORDER BY\n",
        "  total_compensation_ils DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "cost_per_area",
      "displayName": "Cost Per Area Distribution",
      "queryLines": [
        "SELECT\n",
        "  id_esek,\n",
        "  shimush,\n",
        "  shem_rechov,\n",
        "  shetach,\n",
        "  total_compensation_ils,\n",
        "  cost_per_area,\n",
        "  daily_rate_applied\n",
        "FROM\n",
        "  main.tel_aviv_dev.gold_cost_per_area\n",
        "ORDER BY\n",
        "  cost_per_area DESC\n",
        "LIMIT 100"
      ]
    },
    {
      "name": "closure_duration",
      "displayName": "Closure Duration by Street",
      "queryLines": [
        "SELECT\n",
        "  affected_street,\n",
        "  total_closure_days,\n",
        "  num_closure_events,\n",
        "  avg_closure_duration_days\n",
        "FROM\n",
        "  main.tel_aviv_dev.gold_closure_duration_by_street\n",
        "ORDER BY\n",
        "  total_closure_days DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "street_detail",
      "displayName": "Street Compensation Detail",
      "queryLines": [
        "SELECT\n",
        "  shem_rechov,\n",
        "  total_street_compensation_ils,\n",
        "  num_businesses_affected,\n",
        "  avg_compensation_per_business_ils,\n",
        "  max_closure_days,\n",
        "  total_business_closure_days\n",
        "FROM\n",
        "  main.tel_aviv_dev.gold_compensation_per_street\n",
        "ORDER BY\n",
        "  total_street_compensation_ils DESC"
      ]
    },
    {
      "name": "kpi_summary",
      "displayName": "KPI Summary",
      "queryLines": [
        "SELECT\n",
        "  SUM(total_compensation_ils) AS total_compensation,\n",
        "  COUNT(*) AS total_businesses,\n",
        "  AVG(total_compensation_ils) AS avg_compensation,\n",
        "  COUNT(DISTINCT shem_rechov) AS total_streets\n",
        "FROM\n",
        "  main.tel_aviv_dev.gold_compensation_per_business"
      ]
    },
    {
      "name": "scatter_area",
      "displayName": "Business Area vs Compensation",
      "queryLines": [
        "SELECT\n",
        "  shetach,\n",
        "  total_compensation_ils,\n",
        "  shimush,\n",
        "  shem_rechov\n",
        "FROM\n",
        "  main.tel_aviv_dev.gold_cost_per_area\n",
        "WHERE\n",
        "  shetach > 0\n",
        "ORDER BY\n",
        "  total_compensation_ils DESC\n",
        "LIMIT 500"
      ]
    }
  ],
